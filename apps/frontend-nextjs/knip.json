{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "exports": "warn",
    "duplicates": "warn"
  },
  "entry": ["app/**.{tsx,ts}"],
  "project": ["app/**/*.{tsx,ts}"],
  "ignore": ["app/**/*.test.{tsx,ts}"]
}
