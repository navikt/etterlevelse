{
  "name": "frontend-nextjs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "yarn lint-staged",
    "start": "next start",
    "prettier:check": "prettier -c ./app",
    "eslint:check": "eslint . --no-cache --max-warnings=0",
    "knip:test": "yarn knip --max-show-issues 5",
    "knip:cachetest": "yarn knip --cache --max-issues=0",
    "playwright:check": "yarn playwright test",
    "playwright:ui": "yarn playwright test --ui",
    "verify:deps-upgrade": "yarn run prettier:check && yarn run eslint:check && yarn run type-check  && yarn knip:test && yarn knip:cachetest && yarn run build && yarn playwright install && yarn playwright test",
    "pre-commit:deps-check": "node scripts/precommit-deps-check.mjs",
    "lint": "eslint . && prettier -c ./app",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"./app\"",
    "prepare": "cd ../../ && husky apps/frontend-nextjs/.husky",
    "prettier": "prettier --write \"./app\"",
    "type-check": "tsc --project tsconfig.json --noEmit --skipLibCheck false --incremental false",
    "postinstall": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "prettier --list-different --write",
      "eslint --cache --max-warnings=0",
      "bash -c 'yarn run type-check'",
      "bash -c 'yarn knip --max-show-issues 5'",
      "bash -c 'yarn knip --cache --max-issues=0'",
      "bash -c 'yarn playwright install'",
      "bash -c 'yarn playwright test'"
    ]
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@fontsource/source-sans-pro": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@navikt/aksel-icons": "^8.23.0",
    "@navikt/analytics-types": "^0.0.13",
    "@navikt/ds-css": "^8.23.0",
    "@navikt/ds-react": "^8.22.1",
    "@navikt/ds-tailwind": "^8.23.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-ordered-list": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "axios": "^1.21.1",
    "graphql": "17.1.0",
    "json-diff-kit": "^1.0.35",
    "lodash": "^4.18.1",
    "marked": "^18.2.0",
    "moment": "^2.31.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-is": "^19.3.1",
