    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/lodash": "^4.17.27",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "formik": "^2.4.9",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "17.6.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "react-select": "^5.10.2",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "prosemirror-model": "1.25.11",
    "@navikt/ds-react": "patch:@navikt/ds-react@npm%3A8.19.1#~/.yarn/patches/@navikt-ds-react-npm-8.19.1-214d066732.patch",
    "json-diff-kit": "patch:json-diff-kit@npm%3A1.0.35#~/.yarn/patches/json-diff-kit-npm-1.0.35-99a2649175.patch",
    "typescript": "patch:typescript@npm%3A6.0.3#~/.yarn/patches/typescript-npm-6.0.3-585eecd158.patch"
  },
  "packageManager": "yarn@4.16.0"
