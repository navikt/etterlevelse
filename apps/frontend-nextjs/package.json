    "react-markdown": "^10.1.0",
    "react-markdown-editor-lite": "^1.4.2",
    "react-process-string": "^1.2.0",
    "recharts": "^3.11.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
